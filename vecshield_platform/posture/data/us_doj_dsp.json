  "personal_health_data": {"more_than": 10000, "unit": "U.S. persons", "cite": "28 CFR 202.205(d)", "label": "personal health data"},
  "personal_financial_data": {"more_than": 10000, "unit": "U.S. persons", "cite": "28 CFR 202.205(e)", "label": "personal financial data"},
